{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://monkeycards.app/*",
      "https://www.monkeycards.app/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-zoom",
    "updater:default",
    "process:default",
    "opener:default",
    "allow-fetch-desktop-config",
    "allow-desktop-web-ota"
  ]
}
