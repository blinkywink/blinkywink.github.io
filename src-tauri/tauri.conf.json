{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Monkey Cards",
  "version": "1.0.9",
  "identifier": "co.blinkywink.arcade",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && rm -rf dist/downloads"
  },
  "app": {
    "windows": [
      {
        "title": "Monkey Cards",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5RkZBQzg0MzI1QjkxNjIKUldSaWtWc3loS3ovbVdRUDB6eUhJWFZvZkhiYzlBSk5Eb2ljQlpqYjlvUm1iTU1Db3F5aXhJWkwK",
      "endpoints": [
        "https://github.com/blinkywink/blinkywink.github.io/releases/latest/download/latest.json",
        "https://blinkywink.github.io/desktop-latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
