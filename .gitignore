# Dependencies / build
node_modules/
dist/
dist-ssr/
*.local

# Tauri desktop build artifacts (source stays in src-tauri/)
src-tauri/target/

# Capacitor — commit ios/ project; ignore synced web assets + local builds
ios/App/App/public/
ios/App/build/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios-artifacts/

# Capacitor Android
android/app/build/
android/build/
android/.gradle/
android/local.properties
android-artifacts/
*.keystore
*.jks

# Desktop installers (stage locally; host elsewhere — too large for git)
public/downloads/*.dmg
public/downloads/*.exe
public/downloads/*.tar.gz
public/downloads/*.sig
.ci-desktop-stage/

# Updater signing private key — never commit
src-tauri/.updater-key
src-tauri/.updater-key.pub

# Env & secrets — never commit
.env
.env.*
!.env.example
!.env.production

# Logs / OS / editor
logs
*.log
npm-debug.log*
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel
