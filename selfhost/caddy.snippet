# Paste ABOVE the `*.blinkywink.co` catch-all, then:
#   /home/evan/caddy/apply-caddy-live.sh

api.blinkywink.co {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
	request_body {
		max_size 512KB
	}

	@allowedOrigin header_regexp Origin ^https://(www\.)?monkeycards\.app$|^https://([a-z0-9-]+\.)?monkeycards\.pages\.dev$|^https?://([a-z0-9.-]+\.)?localhost(:\d+)?$|^https?://127\.0\.0\.1(:\d+)?$|^https?://\[::1\](:\d+)?$|^https?://10\.1\.10\.\d{1,3}(:\d+)?$|^tauri://localhost$|^capacitor://localhost$|^ionic://localhost$

	handle /auth/v1/health {
		header Access-Control-Allow-Origin *
		header Content-Type application/json
		respond `{"status":"ok"}` 200
	}

	@preflight method OPTIONS
	handle @preflight {
		header @allowedOrigin Access-Control-Allow-Origin {http.request.header.Origin}
		header Access-Control-Allow-Methods "GET, POST, PATCH, PUT, DELETE, OPTIONS, HEAD"
		header Access-Control-Allow-Headers "Authorization, Apikey, Content-Type, Accept, Accept-Profile, Content-Profile, Prefer, Range, X-Client-Info, X-Supabase-Api-Version, X-Bloon-Session"
		header Access-Control-Max-Age "86400"
		header Vary Origin
		respond 204
	}

	handle /rest/v1/* {
		uri strip_prefix /rest/v1
		header @allowedOrigin Access-Control-Allow-Origin {http.request.header.Origin}
		header Access-Control-Expose-Headers "Content-Range, Range-Unit, Preference-Applied"
		header Vary Origin
		reverse_proxy 127.0.0.1:3001 {
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Methods
			header_down -Access-Control-Allow-Headers
		}
	}

	handle /downloads/* {
		reverse_proxy 127.0.0.1:3011
	}

	handle {
		respond 404
	}
}
