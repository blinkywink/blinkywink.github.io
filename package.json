{
  "name": "bloon-arcade",
  "private": true,
  "version": "1.0.19",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop:dev": "tauri dev",
    "desktop:build": "CI=true tsx scripts/with-updater-key.ts tauri build --bundles app,dmg",
    "desktop:build:windows": "PATH=\"/opt/homebrew/opt/llvm/bin:$PATH\" tsx scripts/with-updater-key.ts tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc",
    "desktop:stage-downloads": "tsx scripts/stage-desktop-downloads.ts",
    "desktop:write-latest": "tsx scripts/write-desktop-latest.ts",
    "desktop:publish": "tsx scripts/publish-desktop-release.ts",
    "desktop:release": "tsx scripts/release-desktop.ts",
    "ship": "tsx scripts/ship.ts",
    "clean": "tsx scripts/clean-build.ts",
    "tauri": "tauri",
    "download-assets": "tsx scripts/download-btd6-assets.ts",
    "download-assets:force": "tsx scripts/download-btd6-assets.ts --force",
    "download-heroes": "tsx scripts/download-btd6-heroes.ts",
    "download-heroes:force": "tsx scripts/download-btd6-heroes.ts --force",
    "fetch-tower-costs": "tsx scripts/fetch-tower-costs.ts",
    "prepare-card-assets": "tsx scripts/prepare-card-assets.ts",
    "prepare-card-assets:all": "tsx scripts/prepare-card-assets.ts all",
    "compress-audio": "tsx scripts/compress-audio.ts",
    "export-t5-grid": "tsx scripts/generate-t5-grid-background.ts",
    "export-hub-peeks": "tsx scripts/generate-hub-peeks.ts",
    "reset-accounts": "tsx scripts/reset-all-accounts.ts",
    "smoke-test": "tsx scripts/pre-release-smoke-test.ts",
    "mobile:sync": "npm run build && npx cap sync ios",
    "mobile:sync:android": "npm run build && npx cap sync android",
    "mobile:open": "npx cap open ios",
    "mobile:open:android": "npx cap open android",
    "mobile:ipa": "tsx scripts/build-ios-ipa.ts",
    "mobile:apk": "tsx scripts/build-android-apk.ts",
    "mobile:ota": "tsx scripts/publish-mobile-ota.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-updater": "^8.51.14",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/luckiest-guy": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@supabase/supabase-js": "^2.112.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "html-to-image": "^1.11.13",
    "midi-file": "^1.2.4",
    "parse-sng": "^4.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@tauri-apps/cli": "^2.11.4",
    "@tonejs/midi": "^2.0.28",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sharp": "^0.31.1",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "pg": "^8.23.0",
    "playwright": "^1.55.0",
    "tsx": "^4.23.11",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
